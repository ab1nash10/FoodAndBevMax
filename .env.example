# Local development only. Deployed environments take these from the ConfigMap and
# Secret instead - .env is excluded from every image on purpose.
#
# The portal serves under the /fandb prefix, so it is at http://localhost:3000/fandb
# and not at the root.
NODE_ENV=development

POSTGRES_USER=aahar
POSTGRES_PASSWORD=aahar_password
POSTGRES_DB=aahar
POSTGRES_PORT=5432

# Shared store for OTPs, refresh tokens and rate limits (docker compose starts a Redis on
# REDIS_PORT). Optional: without REDIS_URL each service keeps them in its own memory, and a
# restart signs everyone out.
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

ADMIN_PORTAL_PORT=3000
AUTH_SERVICE_PORT=4001
USER_SERVICE_PORT=4002
ORGANIZATION_SERVICE_PORT=4003

DATABASE_URL=postgresql://aahar:aahar_password@localhost:5432/aahar?schema=public
DOCKER_DATABASE_URL=postgresql://aahar:aahar_password@postgres:5432/aahar?schema=public

# NOTE: the portal does NOT read this file. Next loads frontend/apps/admin-portal/.env, so
# the NEXT_PUBLIC_* values that matter live there - see that directory's .env.example. These
# are kept here only so the whole platform's configuration is visible in one place.
# The portal talks to three separate services. Only the auth URL falls back to
# NEXT_PUBLIC_API_BASE_URL - the other two fall back to the portal's own origin, which
# serves no API locally, so leaving them unset 404s every user and organization call.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4001/api/v1
NEXT_PUBLIC_AUTH_API_URL=http://localhost:4001/api/v1
NEXT_PUBLIC_USER_API_URL=http://localhost:4002/api/v1
NEXT_PUBLIC_ORGANIZATION_API_URL=http://localhost:4003/api/v1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://172.25.208.1:3000,http://172.29.132.245:3000,http://localhost:4001,http://localhost:4002,http://localhost:4003
# Both must be at least 32 characters and different from each other, or no service
# starts. Generate real ones per environment: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-a-strong-access-secret-before-deploying
JWT_REFRESH_SECRET=replace-with-a-strong-refresh-secret-before-deploying
JWT_ACCESS_TOKEN_TTL=30m
JWT_REFRESH_TOKEN_TTL=7d
OTP_TTL_SECONDS=300

# The seeded Super Admin's first password (aahar@admin.local), applied by `pnpm db:seed` only
# while the account has none. Never commit a real value.
ADMIN_PASSWORD=

# Bulk SMS gateway for mobile OTPs (mytoday BulkPush). Leave the credentials empty to have
# development print OTPs to the auth-service log instead of texting them.
SMS_API_URL=https://bulkpush.mytoday.com/BulkSms/SingleMsgApi
SMS_FEED_ID=354105
SMS_SENDER_ID=MAXHSP
SMS_USERNAME=
SMS_PASSWORD=

THROTTLE_TTL=60000
THROTTLE_LIMIT=100
