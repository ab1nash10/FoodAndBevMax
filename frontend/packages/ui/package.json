    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0"
  },
  "peerDependencies": {
    "react": ">=19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
