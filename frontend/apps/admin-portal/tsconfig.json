{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    // An app emits no .d.ts: the base's declaration output (for the packages) made next build
    // demand portable types on every export, and the test helpers' vi.fn() types are not.
    "declaration": false,
    "declarationMap": false,
    "jsx": "preserve",
    "noEmit": true,
    "paths": {
      "@/*": ["./*"],
      "@aahar/api-client": ["../../packages/api-client/src/index.ts"],
      "@aahar/types": ["../../packages/types/src/index.ts"],
      "@aahar/ui": ["../../packages/ui/src/index.ts"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
