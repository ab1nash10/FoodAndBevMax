generator client {
  provider = "prisma-client-js"
}

// The connection URL lives in prisma.config.mjs (Prisma 7); the clients connect through
// createPrismaAdapter() in @aahar/auth.
datasource db {
  provider = "postgresql"
}

enum RecordStatus {
  ACTIVE
  INACTIVE
}

enum LocationScope {
  ALL
  MULTI
  SINGLE
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum FoodType {
  VEG
  NON_VEG
  EGGETARIAN
}

enum ItemType {
  MRP
  READYMADE
  LIVE
}

enum RateType {
  NORMAL
  STAFF
  ROOM
  COUNTER
}

enum GrnStatus {
  DRAFT
  UNDER_VERIFICATION
  PARTIALLY_ACCEPTED
  ACCEPTED
  REJECTED
  POSTED_TO_STOCK
  CANCELLED
}

enum KitchenProductionStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum TransferStatus {
  DRAFT
  PENDING_ACKNOWLEDGEMENT
  ACKNOWLEDGED
  CANCELLED
}

enum TransferAcknowledgementStatus {
  ACCEPTED_FULL
  ACCEPTED_PARTIAL
  REJECTED_FULL
}

enum PrimaryUpiProvider {
  PHONEPE
  UPI_PAYTM
  UPI_SALE
  UPI_BHARAT_QR
  BHARATPE
  GOOGLE_PAY
  OTHER
}

enum OnlinePaymentOption {
  NONE
  PAYU
  RAZORPAY
}

enum InventoryLocationType {
  STORE
  KITCHEN
  RESTAURANT
  COUNTER
}

enum StockTransactionType {
  GRN_IN
  KITCHEN_PRODUCTION_IN
  KITCHEN_TRANSFER_OUT
  RESTAURANT_TRANSFER_IN
  STORE_TO_RESTAURANT_OUT
  RESTAURANT_RECEIVE_IN
  TRANSFER_REJECTED_RETURN_IN
}

enum StockReferenceType {
  GRN
  KITCHEN_PRODUCTION
  TRANSFER
  TRANSFER_ACKNOWLEDGEMENT
}

model User {
  id             String     @id @default(uuid()) @db.Uuid
  employeeCode   String     @unique @map("employee_code")
  name           String
  email          String?    @unique
  mobile         String     @unique
  passwordHash   String?    @map("password_hash")
  designation    String?
  avatarUrl      String?    @map("avatar_url")
  /// Per-user portal preferences (theme, default location, start page, muted notification
  /// categories). Null means every default; see user-service src/preferences.
  preferences    Json?
  /// Bumped whenever an admin changes the user. Tokens carry the version they were issued at,
  /// so a bump ends every session the user has open and they must sign in again.
  sessionVersion Int        @default(0) @map("session_version")
  status         UserStatus @default(ACTIVE)
  hospitalId     String?    @map("hospital_id") @db.Uuid
  createdAt      DateTime   @default(now()) @map("created_at")
  createdBy      String?    @map("created_by") @db.Uuid
  updatedAt      DateTime   @updatedAt @map("updated_at")
  updatedBy      String?    @map("updated_by") @db.Uuid
  deletedAt      DateTime?  @map("deleted_at")

  auditLogs                AuditLog[]
  assignedHospitals        UserHospital[]
  hospital                 Hospital?           @relation(fields: [hospitalId], references: [id])
  notifications            Notification[]
  kitchenProductionsAsChef KitchenProduction[] @relation("KitchenProductionChef")
  permissionOverrides      UserPermission[]
  roles                    UserRole[]

  @@index([hospitalId])
  @@index([deletedAt])
  @@map("users")
}

model Role {
  id            String        @id @default(uuid()) @db.Uuid
  name          String        @unique
  description   String?
  locationScope LocationScope @default(SINGLE) @map("location_scope")
  status        RecordStatus  @default(ACTIVE)
  createdAt     DateTime      @default(now()) @map("created_at")
  createdBy     String?       @map("created_by") @db.Uuid
  updatedAt     DateTime      @updatedAt @map("updated_at")
  updatedBy     String?       @map("updated_by") @db.Uuid
  deletedAt     DateTime?     @map("deleted_at")

  permissions RolePermission[]
  users       UserRole[]

  @@index([deletedAt])
  @@map("roles")
}

model Permission {
  id          String    @id @default(uuid()) @db.Uuid
  code        String    @unique
  module      String
  action      String
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")
  createdBy   String?   @map("created_by") @db.Uuid
  updatedAt   DateTime  @updatedAt @map("updated_at")
  updatedBy   String?   @map("updated_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")

  roles         RolePermission[]
  userOverrides UserPermission[]

  @@index([module, action])
  @@index([deletedAt])
  @@map("permissions")
}

model UserRole {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  roleId    String    @map("role_id") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  role Role @relation(fields: [roleId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@unique([userId, roleId])
  @@index([roleId])
  @@index([deletedAt])
  @@map("user_roles")
}

model UserPermission {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  permissionId String    @map("permission_id") @db.Uuid
  granted      Boolean
  createdAt    DateTime  @default(now()) @map("created_at")
  createdBy    String?   @map("created_by") @db.Uuid
  updatedAt    DateTime  @updatedAt @map("updated_at")
  updatedBy    String?   @map("updated_by") @db.Uuid
  deletedAt    DateTime? @map("deleted_at")

  permission Permission @relation(fields: [permissionId], references: [id])
  user       User       @relation(fields: [userId], references: [id])

  @@unique([userId, permissionId])
  @@index([permissionId])
  @@index([deletedAt])
  @@map("user_permissions")
}

model RolePermission {
  id           String    @id @default(uuid()) @db.Uuid
  roleId       String    @map("role_id") @db.Uuid
  permissionId String    @map("permission_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")
  createdBy    String?   @map("created_by") @db.Uuid
  updatedAt    DateTime  @updatedAt @map("updated_at")
  updatedBy    String?   @map("updated_by") @db.Uuid
  deletedAt    DateTime? @map("deleted_at")

  permission Permission @relation(fields: [permissionId], references: [id])
  role       Role       @relation(fields: [roleId], references: [id])

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@index([deletedAt])
  @@map("role_permissions")
}

model Hospital {
  id                  String              @id @default(uuid()) @db.Uuid
  hospitalCode        String              @unique @map("hospital_code")
  hospitalName        String              @map("hospital_name")
  displayName         String?             @map("display_name")
  address             String?
  city                String?
  state               String?
  postalCode          String?             @map("postal_code")
  latitude            String?
  longitude           String?
  area                String?
  ipAddress           String?             @map("ip_address")
  visitingCardAddress String?             @map("visiting_card_address")
  onlinePaymentOption OnlinePaymentOption @default(NONE) @map("online_payment_option")
  gstApplicable       Boolean             @default(true) @map("gst_applicable")
  billPrefix          String?             @map("bill_prefix")
  isActive            Boolean             @default(true) @map("is_active")
  createdAt           DateTime            @default(now()) @map("created_at")
  createdBy           String?             @map("created_by") @db.Uuid
  updatedAt           DateTime            @updatedAt @map("updated_at")
  updatedBy           String?             @map("updated_by") @db.Uuid
  deletedAt           DateTime?           @map("deleted_at")

  auditLogs                AuditLog[]
  counters                 Counter[]
  grns                     Grn[]
  kitchenProductions       KitchenProduction[]
  kitchens                 Kitchen[]
  locations                Location[]
  assignedUsers            UserHospital[]
  notifications            Notification[]
  itemPrices               ItemPrice[]
  paymentMachines          PaymentMachine[]
  posDevices               PosDevice[]
  restaurants              Restaurant[]
  restaurantMenus          RestaurantMenu[]
  stockBalances            StockBalance[]
  stockLedgers             StockLedger[]
  stores                   Store[]
  transferAcknowledgements TransferAcknowledgement[]
  transfers                Transfer[]
  users                    User[]

  @@index([deletedAt])
  @@index([isActive])
  @@map("hospitals")
}

model Location {
  id           String    @id @default(uuid()) @db.Uuid
  hospitalId   String    @map("hospital_id") @db.Uuid
  locationName String    @map("location_name")
  building     String?
  floor        String?
  area         String?
  address      String?
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  createdBy    String?   @map("created_by") @db.Uuid
  updatedAt    DateTime  @updatedAt @map("updated_at")
  updatedBy    String?   @map("updated_by") @db.Uuid
  deletedAt    DateTime? @map("deleted_at")

  hospital    Hospital     @relation(fields: [hospitalId], references: [id])
  kitchens    Kitchen[]
  restaurants Restaurant[]
  stores      Store[]

  @@index([hospitalId])
  @@index([deletedAt])
  @@index([isActive])
  @@map("locations")
}

model Store {
  id         String    @id @default(uuid()) @db.Uuid
  hospitalId String    @map("hospital_id") @db.Uuid
  locationId String?   @map("location_id") @db.Uuid
  storeCode  String    @map("store_code")
  storeName  String    @map("store_name")
  storeType  String?   @map("store_type")
  address    String?
  isActive   Boolean   @default(true) @map("is_active")
  createdAt  DateTime  @default(now()) @map("created_at")
  createdBy  String?   @map("created_by") @db.Uuid
  updatedAt  DateTime  @updatedAt @map("updated_at")
  updatedBy  String?   @map("updated_by") @db.Uuid
  deletedAt  DateTime? @map("deleted_at")

  hospital    Hospital     @relation(fields: [hospitalId], references: [id])
  location    Location?    @relation(fields: [locationId], references: [id])
  grns        Grn[]
  storeItems  StoreItem[]
  restaurants Restaurant[]

  @@unique([hospitalId, storeCode])
  @@index([hospitalId])
  @@index([locationId])
  @@index([deletedAt])
  @@index([isActive])
  @@map("stores")
}

model Kitchen {
  id          String    @id @default(uuid()) @db.Uuid
  hospitalId  String    @map("hospital_id") @db.Uuid
  locationId  String?   @map("location_id") @db.Uuid
  kitchenCode String    @map("kitchen_code")
  kitchenName String    @map("kitchen_name")
  openingTime String?   @map("opening_time") @db.VarChar(5)
  closingTime String?   @map("closing_time") @db.VarChar(5)
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  createdBy   String?   @map("created_by") @db.Uuid
  updatedAt   DateTime  @updatedAt @map("updated_at")
  updatedBy   String?   @map("updated_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")

  hospital           Hospital            @relation(fields: [hospitalId], references: [id])
  location           Location?           @relation(fields: [locationId], references: [id])
  kitchenItems       KitchenItem[]
  productions        KitchenProduction[]
  restaurants        Restaurant[]
  restaurantKitchens RestaurantKitchen[]

  @@unique([hospitalId, kitchenCode])
  @@index([hospitalId])
  @@index([locationId])
  @@index([deletedAt])
  @@index([isActive])
  @@map("kitchens")
}

model Restaurant {
  id                       String    @id @default(uuid()) @db.Uuid
  hospitalId               String    @map("hospital_id") @db.Uuid
  locationId               String?   @map("location_id") @db.Uuid
  storeId                  String?   @map("store_id") @db.Uuid
  kitchenId                String?   @map("kitchen_id") @db.Uuid
  restaurantCode           String    @map("restaurant_code")
  restaurantName           String    @map("restaurant_name")
  email                    String?
  mobile                   String?
  thumbnailUrl             String?   @map("thumbnail_url")
  coverImageUrl            String?   @map("cover_image_url")
  gstNumber                String?   @map("gst_number")
  panNumber                String?   @map("pan_number")
  fssaiNumber              String?   @map("fssai_number")
  legalName                String?   @map("legal_name")
  gstAddress               String?   @map("gst_address")
  isRegisteredInGst        Boolean   @default(false) @map("is_registered_in_gst")
  address                  String?
  openingTime              String?   @map("opening_time") @db.VarChar(5)
  closingTime              String?   @map("closing_time") @db.VarChar(5)
  normalDiscountApplicable Boolean   @default(false) @map("normal_discount_applicable")
  staffDiscountApplicable  Boolean   @default(false) @map("staff_discount_applicable")
  onlineOrderingEnabled    Boolean   @default(false) @map("online_ordering_enabled")
  inRoomDiningEnabled      Boolean   @default(false) @map("in_room_dining_enabled")
  b2cQrEnabled             Boolean   @default(false) @map("b2c_qr_enabled")
  offline                  Boolean   @default(false)
  open24x7                 Boolean   @default(false) @map("open_24x7")
  vegOnly                  Boolean   @default(false) @map("veg_only")
  takeaway                 Boolean   @default(false)
  delivery                 Boolean   @default(false)
  homeDelivery             Boolean   @default(false) @map("home_delivery")
  atTableDining            Boolean   @default(false) @map("at_table_dining")
  inCarDining              Boolean   @default(false) @map("in_car_dining")
  posOrders                Boolean   @default(false) @map("pos_orders")
  inventory                Boolean   @default(false)
  qrUnitName               String?   @map("qr_unit_name")
  upiId                    String?   @map("upi_id")
  bankName                 String?   @map("bank_name")
  bankBranch               String?   @map("bank_branch")
  ifscCode                 String?   @map("ifsc_code")
  accountNumber            String?   @map("account_number")
  sodexoMid                String?   @map("sodexo_mid")
  sodexoTid                String?   @map("sodexo_tid")
  sunBu                    String?   @map("sun_bu")
  sunT1                    String?   @map("sun_t1")
  sunT2                    String?   @map("sun_t2")
  isActive                 Boolean   @default(true) @map("is_active")
  createdAt                DateTime  @default(now()) @map("created_at")
  createdBy                String?   @map("created_by") @db.Uuid
  updatedAt                DateTime  @updatedAt @map("updated_at")
  updatedBy                String?   @map("updated_by") @db.Uuid
  deletedAt                DateTime? @map("deleted_at")

  counters           Counter[]
  itemPrices         ItemPrice[]
  posDeviceMappings  PosDeviceRestaurant[]
  restaurantMenus    RestaurantMenu[]
  restaurantKitchens RestaurantKitchen[]
  hospital           Hospital              @relation(fields: [hospitalId], references: [id])
  kitchen            Kitchen?              @relation(fields: [kitchenId], references: [id])
  location           Location?             @relation(fields: [locationId], references: [id])
  store              Store?                @relation(fields: [storeId], references: [id])

  @@unique([hospitalId, restaurantCode])
  @@index([hospitalId])
  @@index([locationId])
  @@index([storeId])
  @@index([kitchenId])
  @@index([deletedAt])
  @@index([isActive])
  @@map("restaurants")
}

model RestaurantKitchen {
  id           String    @id @default(uuid()) @db.Uuid
  restaurantId String    @map("restaurant_id") @db.Uuid
  kitchenId    String    @map("kitchen_id") @db.Uuid
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  createdBy    String?   @map("created_by") @db.Uuid
  updatedAt    DateTime  @updatedAt @map("updated_at")
  updatedBy    String?   @map("updated_by") @db.Uuid
  deletedAt    DateTime? @map("deleted_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  kitchen    Kitchen    @relation(fields: [kitchenId], references: [id])

  @@unique([restaurantId, kitchenId])
  @@index([deletedAt])
  @@index([isActive])
  @@index([kitchenId])
  @@index([restaurantId])
  @@map("restaurant_kitchens")
}

model Counter {
  id               String    @id @default(uuid()) @db.Uuid
  hospitalId       String    @map("hospital_id") @db.Uuid
  restaurantId     String    @map("restaurant_id") @db.Uuid
  counterCode      String    @map("counter_code")
  counterName      String    @map("counter_name")
  posDeviceId      String?   @map("pos_device_id")
  paymentDeviceId  String?   @map("payment_device_id")
  pineLabsDeviceId String?   @map("pine_labs_device_id")
  isActive         Boolean   @default(true) @map("is_active")
  createdAt        DateTime  @default(now()) @map("created_at")
  createdBy        String?   @map("created_by") @db.Uuid
  updatedAt        DateTime  @updatedAt @map("updated_at")
  updatedBy        String?   @map("updated_by") @db.Uuid
  deletedAt        DateTime? @map("deleted_at")

  hospital   Hospital   @relation(fields: [hospitalId], references: [id])
  restaurant Restaurant @relation(fields: [restaurantId], references: [id])

  @@unique([restaurantId, counterCode])
  @@index([hospitalId])
  @@index([restaurantId])
  @@index([deletedAt])
  @@index([isActive])
  @@map("counters")
}

model PosDevice {
  id                    String    @id @default(uuid()) @db.Uuid
  hospitalId            String    @map("hospital_id") @db.Uuid
  code                  String
  name                  String
  entity                String?
  hostName              String?   @map("host_name")
  isKotPrintEnabled     Boolean   @default(false) @map("is_kot_print_enabled")
  isInvoicePrintEnabled Boolean   @default(false) @map("is_invoice_print_enabled")
  isActive              Boolean   @default(true) @map("is_active")
  createdAt             DateTime  @default(now()) @map("created_at")
  createdBy             String?   @map("created_by") @db.Uuid
  updatedAt             DateTime  @updatedAt @map("updated_at")
  updatedBy             String?   @map("updated_by") @db.Uuid
  deletedAt             DateTime? @map("deleted_at")

  hospital        Hospital              @relation(fields: [hospitalId], references: [id])
  paymentMachines PaymentMachine[]
  restaurants     PosDeviceRestaurant[]

  @@unique([hospitalId, code])
  @@index([hospitalId])
  @@index([deletedAt])
  @@index([isActive])
  @@index([hostName])
  @@map("pos_devices")
}

model PosDeviceRestaurant {
  id           String    @id @default(uuid()) @db.Uuid
  posDeviceId  String    @map("pos_device_id") @db.Uuid
  restaurantId String    @map("restaurant_id") @db.Uuid
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  createdBy    String?   @map("created_by") @db.Uuid
  updatedAt    DateTime  @updatedAt @map("updated_at")
  updatedBy    String?   @map("updated_by") @db.Uuid
  deletedAt    DateTime? @map("deleted_at")

  posDevice  PosDevice  @relation(fields: [posDeviceId], references: [id])
  restaurant Restaurant @relation(fields: [restaurantId], references: [id])

  @@unique([posDeviceId, restaurantId])
  @@index([deletedAt])
  @@index([isActive])
  @@index([posDeviceId])
  @@index([restaurantId])
  @@map("pos_device_restaurants")
}

model PaymentMachine {
  id                          String              @id @default(uuid()) @db.Uuid
  hospitalId                  String              @map("hospital_id") @db.Uuid
  posDeviceId                 String              @map("pos_device_id") @db.Uuid
  name                        String
  serialNumber                String?             @map("serial_number")
  pinelabMerchantId           String?             @map("pinelab_merchant_id")
  pinelabSecurityToken        String?             @map("pinelab_security_token")
  pinelabImei                 String?             @map("pinelab_imei")
  pinelabMerchantStorePosCode String?             @map("pinelab_merchant_store_pos_code")
  primaryUpi                  PrimaryUpiProvider? @map("primary_upi")
  isDefault                   Boolean             @default(false) @map("is_default")
  isActive                    Boolean             @default(true) @map("is_active")
  createdAt                   DateTime            @default(now()) @map("created_at")
  createdBy                   String?             @map("created_by") @db.Uuid
  updatedAt                   DateTime            @updatedAt @map("updated_at")
  updatedBy                   String?             @map("updated_by") @db.Uuid
  deletedAt                   DateTime?           @map("deleted_at")

  hospital  Hospital  @relation(fields: [hospitalId], references: [id])
  posDevice PosDevice @relation(fields: [posDeviceId], references: [id])

  @@index([hospitalId])
  @@index([posDeviceId])
  @@index([deletedAt])
  @@index([isActive])
  @@index([isDefault])
  @@map("payment_machines")
}

model ItemCategory {
  id             String    @id @default(uuid()) @db.Uuid
  categoryName   String    @unique @map("category_name")
  normalizedName String    @map("normalized_name")
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")
  createdBy      String?   @map("created_by") @db.Uuid
  updatedAt      DateTime  @updatedAt @map("updated_at")
  updatedBy      String?   @map("updated_by") @db.Uuid
  deletedAt      DateTime? @map("deleted_at")

  items Item[]

  @@index([deletedAt])
  @@index([isActive])
  @@index([normalizedName])
  @@map("item_categories")
}

model Item {
  id                     String    @id @default(uuid()) @db.Uuid
  itemCode               String    @unique @map("item_code")
  itemName               String    @map("item_name")
  normalizedName         String    @map("normalized_name")
  categoryId             String    @map("category_id") @db.Uuid
  type                   FoodType
  itemType               ItemType  @map("item_type")
  preparationTimeMinutes Int?      @map("preparation_time_minutes")
  hsnCode                String?   @map("hsn_code")
  isActive               Boolean   @default(true) @map("is_active")
  createdAt              DateTime  @default(now()) @map("created_at")
  createdBy              String?   @map("created_by") @db.Uuid
  updatedAt              DateTime  @updatedAt @map("updated_at")
  updatedBy              String?   @map("updated_by") @db.Uuid
  deletedAt              DateTime? @map("deleted_at")

  category                     ItemCategory                  @relation(fields: [categoryId], references: [id])
  grnBatches                   GrnBatch[]
  grnLines                     GrnLine[]
  kitchenItems                 KitchenItem[]
  kitchenProductionLines       KitchenProductionLine[]
  itemPrices                   ItemPrice[]
  restaurantMenus              RestaurantMenu[]
  stockBalances                StockBalance[]
  stockLedgers                 StockLedger[]
  storeItems                   StoreItem[]
  transferAcknowledgementLines TransferAcknowledgementLine[]
  transferLines                TransferLine[]

  @@index([categoryId])
  @@index([deletedAt])
  @@index([isActive])
  @@index([itemType])
  @@index([normalizedName])
  @@index([type])
  @@map("items")
}

model ItemPrice {
  id             String    @id @default(uuid()) @db.Uuid
  hospitalId     String    @map("hospital_id") @db.Uuid
  restaurantId   String?   @map("restaurant_id") @db.Uuid
  itemId         String    @map("item_id") @db.Uuid
  rateType       RateType  @map("rate_type")
  price          Decimal   @db.Decimal(12, 2)
  isTaxInclusive Boolean   @default(true) @map("is_tax_inclusive")
  gstPercent     Decimal?  @map("gst_percent") @db.Decimal(5, 2)
  effectiveFrom  DateTime  @map("effective_from") @db.Date
  effectiveTo    DateTime? @map("effective_to") @db.Date
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")
  createdBy      String?   @map("created_by") @db.Uuid
  updatedAt      DateTime  @updatedAt @map("updated_at")
  updatedBy      String?   @map("updated_by") @db.Uuid
  deletedAt      DateTime? @map("deleted_at")

  hospital   Hospital    @relation(fields: [hospitalId], references: [id])
  item       Item        @relation(fields: [itemId], references: [id])
  restaurant Restaurant? @relation(fields: [restaurantId], references: [id])

  @@index([deletedAt])
  @@index([effectiveFrom])
  @@index([effectiveTo])
  @@index([hospitalId])
  @@index([hospitalId, restaurantId, itemId, rateType])
  @@index([isActive])
  @@index([itemId])
  @@index([rateType])
  @@index([restaurantId])
  @@map("item_prices")
}

model TimeSlot {
  id                String    @id @default(uuid()) @db.Uuid
  slotName          String    @unique @map("slot_name")
  startTime         String?   @map("start_time") @db.VarChar(5)
  endTime           String?   @map("end_time") @db.VarChar(5)
  isAlwaysAvailable Boolean   @default(false) @map("is_always_available")
  isActive          Boolean   @default(true) @map("is_active")
  createdAt         DateTime  @default(now()) @map("created_at")
  createdBy         String?   @map("created_by") @db.Uuid
  updatedAt         DateTime  @updatedAt @map("updated_at")
  updatedBy         String?   @map("updated_by") @db.Uuid
  deletedAt         DateTime? @map("deleted_at")

  @@index([deletedAt])
  @@index([isActive])
  @@index([isAlwaysAvailable])
  @@map("time_slots")
}

model StoreItem {
  id        String    @id @default(uuid()) @db.Uuid
  storeId   String    @map("store_id") @db.Uuid
  itemId    String    @map("item_id") @db.Uuid
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  item  Item  @relation(fields: [itemId], references: [id])
  store Store @relation(fields: [storeId], references: [id])

  @@index([deletedAt])
  @@index([isActive])
  @@index([itemId])
  @@index([storeId])
  @@index([storeId, itemId])
  @@map("store_items")
}

model KitchenItem {
  id        String    @id @default(uuid()) @db.Uuid
  kitchenId String    @map("kitchen_id") @db.Uuid
  itemId    String    @map("item_id") @db.Uuid
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  item    Item    @relation(fields: [itemId], references: [id])
  kitchen Kitchen @relation(fields: [kitchenId], references: [id])

  @@index([deletedAt])
  @@index([isActive])
  @@index([itemId])
  @@index([kitchenId])
  @@index([kitchenId, itemId])
  @@map("kitchen_items")
}

model RestaurantMenu {
  id           String    @id @default(uuid()) @db.Uuid
  hospitalId   String    @map("hospital_id") @db.Uuid
  restaurantId String    @map("restaurant_id") @db.Uuid
  itemId       String    @map("item_id") @db.Uuid
  timeSlotIds  String[]  @default([]) @map("time_slot_ids")
  daysOfWeek   String[]  @default([]) @map("days_of_week")
  isAvailable  Boolean   @default(true) @map("is_available")
  isActive     Boolean   @default(true) @map("is_active")
  displayOrder Int       @default(0) @map("display_order")
  createdAt    DateTime  @default(now()) @map("created_at")
  createdBy    String?   @map("created_by") @db.Uuid
  updatedAt    DateTime  @updatedAt @map("updated_at")
  updatedBy    String?   @map("updated_by") @db.Uuid
  deletedAt    DateTime? @map("deleted_at")

  hospital   Hospital   @relation(fields: [hospitalId], references: [id])
  item       Item       @relation(fields: [itemId], references: [id])
  restaurant Restaurant @relation(fields: [restaurantId], references: [id])

  @@index([deletedAt])
  @@index([hospitalId])
  @@index([isActive])
  @@index([itemId])
  @@index([restaurantId])
  @@index([restaurantId, itemId])
  @@map("restaurant_menus")
}

model Employee {
  id                  String    @id @default(uuid()) @db.Uuid
  employeeCode        String    @unique @map("employee_code")
  employeeName        String    @map("employee_name")
  department          String?
  designation         String?
  mobile              String?
  eligibleForDiscount Boolean   @default(true) @map("eligible_for_discount")
  isActive            Boolean   @default(true) @map("is_active")
  createdAt           DateTime  @default(now()) @map("created_at")
  createdBy           String?   @map("created_by") @db.Uuid
  updatedAt           DateTime  @updatedAt @map("updated_at")
  updatedBy           String?   @map("updated_by") @db.Uuid
  deletedAt           DateTime? @map("deleted_at")

  @@index([deletedAt])
  @@index([eligibleForDiscount])
  @@index([isActive])
  @@map("employees")
}

model Grn {
  id            String    @id @default(uuid()) @db.Uuid
  grnNumber     String    @unique @default(dbgenerated("('GRN'::text || regexp_replace(lpad((nextval('grn_number_seq'::regclass))::text, 20, '0'::text), '^0{0,14}'::text, ''::text))")) @map("grn_number")
  hospitalId    String    @map("hospital_id") @db.Uuid
  storeId       String    @map("store_id") @db.Uuid
  receivedDate  DateTime  @map("received_date")
  receivedBy    String    @map("received_by")
  vendorName    String?   @map("vendor_name")
  poNumber      String?   @map("po_number")
  invoiceNumber String?   @map("invoice_number")
  remarks       String?
  status        GrnStatus @default(DRAFT)
  createdAt     DateTime  @default(now()) @map("created_at")
  createdBy     String?   @map("created_by") @db.Uuid
  updatedAt     DateTime  @updatedAt @map("updated_at")
  updatedBy     String?   @map("updated_by") @db.Uuid
  deletedAt     DateTime? @map("deleted_at")

  hospital Hospital  @relation(fields: [hospitalId], references: [id])
  lines    GrnLine[]
  store    Store     @relation(fields: [storeId], references: [id])

  @@index([deletedAt])
  @@index([hospitalId])
  @@index([hospitalId, status, deletedAt])
  @@index([receivedDate])
  @@index([status])
  @@index([storeId])
  @@map("grns")
}

model GrnLine {
  id              String    @id @default(uuid()) @db.Uuid
  grnId           String    @map("grn_id") @db.Uuid
  itemId          String    @map("item_id") @db.Uuid
  orderedQty      Decimal?  @map("ordered_qty") @db.Decimal(12, 3)
  receivedQty     Decimal   @map("received_qty") @db.Decimal(12, 3)
  acceptedQty     Decimal   @map("accepted_qty") @db.Decimal(12, 3)
  rejectedQty     Decimal   @default(0) @map("rejected_qty") @db.Decimal(12, 3)
  rejectionReason String?   @map("rejection_reason")
  remarks         String?
  createdAt       DateTime  @default(now()) @map("created_at")
  createdBy       String?   @map("created_by") @db.Uuid
  updatedAt       DateTime  @updatedAt @map("updated_at")
  updatedBy       String?   @map("updated_by") @db.Uuid
  deletedAt       DateTime? @map("deleted_at")

  batches GrnBatch[]
  grn     Grn        @relation(fields: [grnId], references: [id])
  item    Item       @relation(fields: [itemId], references: [id])

  @@index([deletedAt])
  @@index([grnId])
  @@index([itemId])
  @@map("grn_lines")
}

model GrnBatch {
  id                String    @id @default(uuid()) @db.Uuid
  grnLineId         String    @map("grn_line_id") @db.Uuid
  itemId            String    @map("item_id") @db.Uuid
  batchNumber       String    @map("batch_number")
  manufacturingDate DateTime? @map("manufacturing_date") @db.Date
  expiryDate        DateTime  @map("expiry_date") @db.Date
  receivedQty       Decimal   @map("received_qty") @db.Decimal(12, 3)
  acceptedQty       Decimal   @map("accepted_qty") @db.Decimal(12, 3)
  rejectedQty       Decimal   @default(0) @map("rejected_qty") @db.Decimal(12, 3)
  rejectionReason   String?   @map("rejection_reason")
  createdAt         DateTime  @default(now()) @map("created_at")
  createdBy         String?   @map("created_by") @db.Uuid
  updatedAt         DateTime  @updatedAt @map("updated_at")
  updatedBy         String?   @map("updated_by") @db.Uuid
  deletedAt         DateTime? @map("deleted_at")

  grnLine GrnLine @relation(fields: [grnLineId], references: [id])
  item    Item    @relation(fields: [itemId], references: [id])

  @@index([batchNumber])
  @@index([deletedAt])
  @@index([expiryDate])
  @@index([grnLineId])
  @@index([itemId])
  @@map("grn_batches")
}

model KitchenProduction {
  id               String                  @id @default(uuid()) @db.Uuid
  productionNumber String                  @unique @default(dbgenerated("('PRD'::text || regexp_replace(lpad((nextval('kitchen_production_number_seq'::regclass))::text, 20, '0'::text), '^0{0,16}'::text, ''::text))")) @map("production_number")
  hospitalId       String                  @map("hospital_id") @db.Uuid
  kitchenId        String                  @map("kitchen_id") @db.Uuid
  productionDate   DateTime                @map("production_date")
  businessDate     DateTime                @map("business_date") @db.Date
  chefUserId       String?                 @map("chef_user_id") @db.Uuid
  status           KitchenProductionStatus @default(DRAFT)
  remarks          String?
  createdAt        DateTime                @default(now()) @map("created_at")
  createdBy        String?                 @map("created_by") @db.Uuid
  updatedAt        DateTime                @updatedAt @map("updated_at")
  updatedBy        String?                 @map("updated_by") @db.Uuid
  deletedAt        DateTime?               @map("deleted_at")

  chef     User?                   @relation("KitchenProductionChef", fields: [chefUserId], references: [id])
  hospital Hospital                @relation(fields: [hospitalId], references: [id])
  kitchen  Kitchen                 @relation(fields: [kitchenId], references: [id])
  lines    KitchenProductionLine[]

  @@index([businessDate])
  @@index([chefUserId])
  @@index([deletedAt])
  @@index([hospitalId])
  @@index([kitchenId])
  @@index([productionDate])
  @@index([status])
  @@map("kitchen_productions")
}

model KitchenProductionLine {
  id           String    @id @default(uuid()) @db.Uuid
  productionId String    @map("production_id") @db.Uuid
  itemId       String    @map("item_id") @db.Uuid
  producedQty  Decimal   @map("produced_qty") @db.Decimal(12, 3)
  wastageQty   Decimal   @default(0) @map("wastage_qty") @db.Decimal(12, 3)
  acceptedQty  Decimal   @map("accepted_qty") @db.Decimal(12, 3)
  remarks      String?
  createdAt    DateTime  @default(now()) @map("created_at")
  createdBy    String?   @map("created_by") @db.Uuid
  updatedAt    DateTime  @updatedAt @map("updated_at")
  updatedBy    String?   @map("updated_by") @db.Uuid
  deletedAt    DateTime? @map("deleted_at")

  item       Item              @relation(fields: [itemId], references: [id])
  production KitchenProduction @relation(fields: [productionId], references: [id])

  @@index([deletedAt])
  @@index([itemId])
  @@index([productionId])
  @@map("kitchen_production_lines")
}

model Transfer {
  id              String                @id @default(uuid()) @db.Uuid
  transferNumber  String                @unique @default(dbgenerated("('TRF'::text || regexp_replace(lpad((nextval('transfer_number_seq'::regclass))::text, 20, '0'::text), '^0{0,16}'::text, ''::text))")) @map("transfer_number")
  hospitalId      String                @map("hospital_id") @db.Uuid
  sourceType      InventoryLocationType @map("source_type")
  sourceId        String                @map("source_id") @db.Uuid
  destinationType InventoryLocationType @map("destination_type")
  destinationId   String                @map("destination_id") @db.Uuid
  transferDate    DateTime              @map("transfer_date")
  businessDate    DateTime              @map("business_date") @db.Date
  status          TransferStatus        @default(DRAFT)
  remarks         String?
  createdAt       DateTime              @default(now()) @map("created_at")
  createdBy       String?               @map("created_by") @db.Uuid
  updatedAt       DateTime              @updatedAt @map("updated_at")
  updatedBy       String?               @map("updated_by") @db.Uuid
  deletedAt       DateTime?             @map("deleted_at")

  acknowledgements TransferAcknowledgement[]
  hospital         Hospital                  @relation(fields: [hospitalId], references: [id])
  lines            TransferLine[]

  @@index([businessDate])
  @@index([deletedAt])
  @@index([destinationType, destinationId])
  @@index([hospitalId])
  @@index([hospitalId, status, deletedAt])
  @@index([sourceType, sourceId])
  @@index([status])
  @@index([transferDate])
  @@map("transfers")
}

model TransferLine {
  id              String    @id @default(uuid()) @db.Uuid
  transferId      String    @map("transfer_id") @db.Uuid
  itemId          String    @map("item_id") @db.Uuid
  batchNumber     String?   @map("batch_number")
  expiryDate      DateTime? @map("expiry_date") @db.Date
  sentQty         Decimal   @map("sent_qty") @db.Decimal(12, 3)
  acceptedQty     Decimal   @default(0) @map("accepted_qty") @db.Decimal(12, 3)
  rejectedQty     Decimal   @default(0) @map("rejected_qty") @db.Decimal(12, 3)
  rejectionReason String?   @map("rejection_reason")
  remarks         String?
  createdAt       DateTime  @default(now()) @map("created_at")
  createdBy       String?   @map("created_by") @db.Uuid
  updatedAt       DateTime  @updatedAt @map("updated_at")
  updatedBy       String?   @map("updated_by") @db.Uuid
  deletedAt       DateTime? @map("deleted_at")

  acknowledgementLines TransferAcknowledgementLine[]
  item                 Item                          @relation(fields: [itemId], references: [id])
  transfer             Transfer                      @relation(fields: [transferId], references: [id])

  @@index([batchNumber])
  @@index([deletedAt])
  @@index([expiryDate])
  @@index([itemId])
  @@index([transferId])
  @@map("transfer_lines")
}

model TransferAcknowledgement {
  id                  String                        @id @default(uuid()) @db.Uuid
  transferId          String                        @unique @map("transfer_id") @db.Uuid
  hospitalId          String                        @map("hospital_id") @db.Uuid
  acknowledgementDate DateTime                      @default(now()) @map("acknowledgement_date")
  status              TransferAcknowledgementStatus
  remarks             String?
  createdAt           DateTime                      @default(now()) @map("created_at")
  createdBy           String?                       @map("created_by") @db.Uuid
  updatedAt           DateTime                      @updatedAt @map("updated_at")
  updatedBy           String?                       @map("updated_by") @db.Uuid
  deletedAt           DateTime?                     @map("deleted_at")

  hospital Hospital                      @relation(fields: [hospitalId], references: [id])
  lines    TransferAcknowledgementLine[]
  transfer Transfer                      @relation(fields: [transferId], references: [id])

  @@index([acknowledgementDate])
  @@index([deletedAt])
  @@index([hospitalId])
  @@index([status])
  @@map("transfer_acknowledgements")
}

model TransferAcknowledgementLine {
  id                String    @id @default(uuid()) @db.Uuid
  acknowledgementId String    @map("acknowledgement_id") @db.Uuid
  transferLineId    String    @map("transfer_line_id") @db.Uuid
  itemId            String    @map("item_id") @db.Uuid
  batchNumber       String?   @map("batch_number")
  expiryDate        DateTime? @map("expiry_date") @db.Date
  sentQty           Decimal   @map("sent_qty") @db.Decimal(12, 3)
  acceptedQty       Decimal   @map("accepted_qty") @db.Decimal(12, 3)
  rejectedQty       Decimal   @default(0) @map("rejected_qty") @db.Decimal(12, 3)
  rejectionReason   String?   @map("rejection_reason")
  remarks           String?
  createdAt         DateTime  @default(now()) @map("created_at")
  createdBy         String?   @map("created_by") @db.Uuid
  updatedAt         DateTime  @updatedAt @map("updated_at")
  updatedBy         String?   @map("updated_by") @db.Uuid
  deletedAt         DateTime? @map("deleted_at")

  acknowledgement TransferAcknowledgement @relation(fields: [acknowledgementId], references: [id])
  item            Item                    @relation(fields: [itemId], references: [id])
  transferLine    TransferLine            @relation(fields: [transferLineId], references: [id])

  @@index([acknowledgementId])
  @@index([batchNumber])
  @@index([deletedAt])
  @@index([expiryDate])
  @@index([itemId])
  @@index([transferLineId])
  @@map("transfer_acknowledgement_lines")
}

model StockLedger {
  id                  String                @id @default(uuid()) @db.Uuid
  hospitalId          String                @map("hospital_id") @db.Uuid
  locationType        InventoryLocationType @map("location_type")
  locationId          String                @map("location_id") @db.Uuid
  itemId              String                @map("item_id") @db.Uuid
  itemType            ItemType              @map("item_type")
  batchNumber         String?               @map("batch_number")
  expiryDate          DateTime?             @map("expiry_date") @db.Date
  transactionType     StockTransactionType  @map("transaction_type")
  referenceType       StockReferenceType?   @map("reference_type")
  referenceId         String?               @map("reference_id") @db.Uuid
  qtyIn               Decimal               @default(0) @map("qty_in") @db.Decimal(12, 3)
  qtyOut              Decimal               @default(0) @map("qty_out") @db.Decimal(12, 3)
  balanceAfter        Decimal               @default(0) @map("balance_after") @db.Decimal(12, 3)
  businessDate        DateTime              @map("business_date") @db.Date
  transactionDateTime DateTime              @map("transaction_datetime")
  remarks             String?
  createdAt           DateTime              @default(now()) @map("created_at")
  createdBy           String?               @map("created_by") @db.Uuid
  updatedAt           DateTime              @updatedAt @map("updated_at")
  updatedBy           String?               @map("updated_by") @db.Uuid
  deletedAt           DateTime?             @map("deleted_at")

  hospital Hospital @relation(fields: [hospitalId], references: [id])
  item     Item     @relation(fields: [itemId], references: [id])

  @@index([batchNumber])
  @@index([businessDate])
  @@index([deletedAt])
  @@index([expiryDate])
  @@index([hospitalId])
  @@index([hospitalId, locationType, locationId, deletedAt], map: "stock_ledgers_hospital_location_deleted_at_idx")
  @@index([itemId])
  @@index([itemId, deletedAt])
  @@index([locationType, locationId])
  @@index([referenceType, referenceId])
  @@index([transactionDateTime])
  @@index([transactionType])
  @@map("stock_ledgers")
}

model StockBalance {
  id            String                @id @default(uuid()) @db.Uuid
  hospitalId    String                @map("hospital_id") @db.Uuid
  locationType  InventoryLocationType @map("location_type")
  locationId    String                @map("location_id") @db.Uuid
  itemId        String                @map("item_id") @db.Uuid
  itemType      ItemType              @map("item_type")
  batchNumber   String?               @map("batch_number")
  expiryDate    DateTime?             @map("expiry_date") @db.Date
  businessDate  DateTime?             @map("business_date") @db.Date
  availableQty  Decimal               @default(0) @map("available_qty") @db.Decimal(12, 3)
  reservedQty   Decimal               @default(0) @map("reserved_qty") @db.Decimal(12, 3)
  lastUpdatedOn DateTime              @default(now()) @map("last_updated_on")
  createdAt     DateTime              @default(now()) @map("created_at")
  createdBy     String?               @map("created_by") @db.Uuid
  updatedAt     DateTime              @updatedAt @map("updated_at")
  updatedBy     String?               @map("updated_by") @db.Uuid
  deletedAt     DateTime?             @map("deleted_at")

  hospital Hospital @relation(fields: [hospitalId], references: [id])
  item     Item     @relation(fields: [itemId], references: [id])

  @@unique([hospitalId, locationType, locationId, itemId, batchNumber, expiryDate, businessDate], map: "stock_balances_unique_stock_key")
  @@index([batchNumber])
  @@index([businessDate])
  @@index([deletedAt])
  @@index([expiryDate])
  @@index([hospitalId])
  @@index([itemId])
  @@index([locationType, locationId])
  @@map("stock_balances")
}

model AuditLog {
  id         String    @id @default(uuid()) @db.Uuid
  hospitalId String?   @map("hospital_id") @db.Uuid
  userId     String?   @map("user_id") @db.Uuid
  entityName String    @map("entity_name")
  entityId   String    @map("entity_id") @db.Uuid
  action     String
  oldValue   Json?     @map("old_value")
  newValue   Json?     @map("new_value")
  ipAddress  String?   @map("ip_address")
  createdAt  DateTime  @default(now()) @map("created_at")
  createdBy  String?   @map("created_by") @db.Uuid
  updatedAt  DateTime  @updatedAt @map("updated_at")
  updatedBy  String?   @map("updated_by") @db.Uuid
  deletedAt  DateTime? @map("deleted_at")

  hospital Hospital? @relation(fields: [hospitalId], references: [id])
  user     User?     @relation(fields: [userId], references: [id])

  @@index([entityName, entityId])
  @@index([hospitalId])
  @@index([userId])
  @@index([deletedAt])
  @@map("audit_logs")
}

model Notification {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  hospitalId String?   @map("hospital_id") @db.Uuid
  category   String
  title      String
  body       String?
  entityName String?   @map("entity_name")
  entityId   String?   @map("entity_id") @db.Uuid
  link       String?
  readAt     DateTime? @map("read_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  createdBy  String?   @map("created_by") @db.Uuid
  updatedAt  DateTime  @updatedAt @map("updated_at")
  updatedBy  String?   @map("updated_by") @db.Uuid
  deletedAt  DateTime? @map("deleted_at")

  hospital Hospital? @relation(fields: [hospitalId], references: [id])
  user     User      @relation(fields: [userId], references: [id])

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@index([hospitalId])
  @@index([deletedAt])
  @@map("notifications")
}

/// Locations a user may operate in. Super Admin ignores this (LocationScope.ALL), Admin may hold
/// several, and every other role is limited to exactly one.
model UserHospital {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  hospitalId String    @map("hospital_id") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at")
  createdBy  String?   @map("created_by") @db.Uuid
  updatedAt  DateTime  @updatedAt @map("updated_at")
  updatedBy  String?   @map("updated_by") @db.Uuid
  deletedAt  DateTime? @map("deleted_at")

  hospital Hospital @relation(fields: [hospitalId], references: [id])
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, hospitalId])
  @@index([hospitalId])
  @@index([deletedAt])
  @@map("user_hospitals")
}
