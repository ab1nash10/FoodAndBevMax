{
  "name": "@aahar/auth",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "admin:password": "tsx --env-file-if-exists=../../../.env src/scripts/set-admin-password.ts",
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "eslint . --max-warnings 0",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@nestjs/common": "^12.1.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.2",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/client": "^7.10.0",
    "helmet": "^8.1.0",
    "ioredis": "^6.0.0",
    "passport-jwt": "^4.0.1",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/common": "^12.1.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.2",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/client": "^7.10.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.16.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "passport-jwt": "^4.0.1",
    "rxjs": "^7.8.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "pg": "^8.16.3"
  }
}
